<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - SkyWings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <%- include('partials/flash') %>

        <% if (!user) { %>
            <div class="card">
                <p>Please <a href="/login">log in</a> to view your profile.</p>
            </div>
        <% } else { %>
            <div class="form-card">
                <h1>My Profile</h1>

                <div class="field">
                    <label>Username</label>
                    <input type="text" value="<%= user.username %>" readonly>
                </div>

                <div class="field">
                    <label>Email</label>
                    <input type="text" value="<%= user.email %>" readonly>
                </div>

                <a href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>" class="btn" style="margin-top:16px;display:inline-block;">
                    Back to Dashboard
                </a>
            </div>
        <% } %>
    </div>
</body>
</html>
