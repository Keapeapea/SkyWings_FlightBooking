<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - SkyWings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <%- include('partials/flash') %>

        <% if (!user) { %>
            <div class="card">
                <p>Please <a href="/login">log in</a> to view your profile.</p>
            </div>
        <% } else { %>
            <div class="form-card">
                <h1>My Profile</h1>

                <div class="field">
                    <label>Username</label>
                    <input type="text" value="<%= user.username %>" readonly>
                </div>

                <div class="field">
                    <label>Email</label>
                    <input type="text" value="<%= user.email %>" readonly>
                </div>

                <div class="field">
                    <label>Gender</label>
                    <div class="gender-options">
                        <label class="gender-option">
                            <input type="radio" name="gender" value="male" <%= profileUser.gender === 'male' ? 'checked' : '' %>>
                            <span>Male</span>
                        </label>
                        <label class="gender-option">
                            <input type="radio" name="gender" value="female" <%= profileUser.gender === 'female' ? 'checked' : '' %>>
                            <span>Female</span>
                        </label>
                        <label class="gender-option">
                            <input type="radio" name="gender" value="other" <%= profileUser.gender === 'other' ? 'checked' : '' %>>
                            <span>Other</span>
                        </label>
                        <label class="gender-option">
                            <input type="radio" name="gender" value="" <%= !profileUser.gender ? 'checked' : '' %>>
                            <span>Prefer not to say</span>
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label for="region">Region</label>
                    <select id="region" name="region">
                        <option value="">Prefer not to say</option>
                        <% const regions = ['Singapore', 'Malaysia', 'Indonesia', 'Thailand', 'Vietnam', 'Philippines',
                                             'Japan', 'South Korea', 'China', 'Taiwan', 'Hong Kong', 'India',
                                             'Australia', 'United Kingdom', 'United States', 'Other']; %>
                        <% regions.forEach(r => { %>
                            <option value="<%= r %>" <%= profileUser.region === r ? 'selected' : '' %>><%= r %></option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="btn btn-accent" style="margin-top:8px;">Save Changes</button>
            </form>

            <hr class="bp-divider" style="margin:22px 0;">

            <h2 style="margin-top:0;">Feedback</h2>
            <p class="meta" style="margin-top:-6px;">Let us know how we're doing or suggest an improvement.</p>

            <form action="/profile/feedback" method="POST">
                <div class="field">
                    <label for="feedback_message">Your feedback</label>
                    <textarea id="feedback_message" name="message" rows="4"
                              placeholder="Tell us what you think..." required></textarea>
                </div>
                <button type="submit" class="btn btn-accent" style="margin-top:8px;">Submit Feedback</button>
            </form>

            <% if (feedbackList && feedbackList.length > 0) { %>
                <h2 style="margin-top:24px;">Your previous feedback</h2>
                <div class="feedback-list">
                    <% feedbackList.forEach(function(fb) { %>
                        <div class="card" style="margin-top:10px; padding:14px;">
                            <p style="margin:0;"><%= fb.message %></p>
                            <p class="meta" style="margin:6px 0 0;">
                                <%= new Date(fb.created_at).toLocaleString() %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <a class="btn" style="background:var(--muted); margin-top:12px; display:inline-block;"
               href="<%= profileUser.role === 'admin' ? '/admin' : '/dashboard' %>">Back to Dashboard</a>
        </div>
    </div>
</body>
</html>
