<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Flight - SkyWings Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container">
        <%- include('partials/flash') %>

        <div class="card">
            <h2>Add New Flight</h2>
            <form action="/admin/flights/add" method="POST">
                <div class="field">
                    <label for="flight_number">Flight Number</label>
                    <input type="text" id="flight_number" name="flight_number" placeholder="e.g. SQ118" required>
                </div>
                <div class="field">
                    <label for="airline">Airline</label>
                    <input type="text" id="airline" name="airline" value="SkyWings Airlines" required>
                </div>
                <div class="field">
                    <label for="origin">Origin</label>
                    <input type="text" id="origin" name="origin" required>
                </div>
                <div class="field">
                    <label for="destination">Destination</label>
                    <input type="text" id="destination" name="destination" required>
                </div>
                <div class="field">
                    <label for="departure_date">Departure Date</label>
                    <input type="date" id="departure_date" name="departure_date" required>
                </div>
                <div class="field">
                    <label for="departure_time">Departure Time</label>
                    <input type="time" id="departure_time" name="departure_time" required>
                </div>
                <div class="field">
                    <label for="arrival_time">Arrival Time</label>
                    <input type="time" id="arrival_time" name="arrival_time" required>
                </div>
                <div class="field">
                    <label for="price">Price (economy, $)</label>
                    <input type="number" id="price" name="price" step="0.01" min="0" required>
                </div>
                <div class="field">
                    <label for="total_seats">Total Seats</label>
                    <input type="number" id="total_seats" name="total_seats" min="1" required>
                </div>
                <button type="submit" class="btn btn-accent">Add Flight</button>
            </form>
        </div>
    </div>
</body>
</html>
