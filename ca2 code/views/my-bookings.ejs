<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Bookings - SkyWings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container">
        <%- include('partials/flash') %>
        <h2>My Bookings</h2>

        <% if (bookings.length === 0) { %>
            <div class="card empty-state">
                You haven't booked any flights yet. <a href="/dashboard">Browse flights</a>
            </div>
        <% } else { %>
            <div class="card">
                <table>
                    <thead>
                        <tr>
                            <th>Flight</th>
                            <th>Route</th>
                            <th>Departure</th>
                            <th>Passenger</th>
                            <th>Pax</th>
                            <th>Class</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(b => { %>
                            <% const badgeClass = b.status === 'flight removed' ? 'flight-removed' : b.status; %>
                            <tr>
                                <td data-label="Flight"><%= b.flight_number %></td>
                                <td data-label="Route"><%= b.origin %> → <%= b.destination %></td>
                                <td data-label="Departure"><%= b.departure_date ? new Date(b.departure_date).toDateString() : 'N/A' %> <%= b.departure_time %></td>
                                <td data-label="Passenger"><%= b.passenger_name %></td>
                                <td data-label="Pax"><%= b.passenger_count %></td>
                                <td data-label="Class"><%= b.seat_class %></td>
                                <td data-label="Total">$<%= Number(b.total_price).toFixed(2) %></td>
                                <td data-label="Status"><span class="badge <%= badgeClass %>"><%= b.status %></span></td>
                                <td data-label="Actions">
                                    <div class="actions">
                                        <% if (b.status === 'confirmed') { %>
                                            <a class="btn btn-sm" href="/bookings/edit/<%= b.id %>">Edit</a>
                                            <form action="/bookings/delete/<%= b.id %>" method="POST" onsubmit="return confirm('Cancel this booking?');">
                                                <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                            </form>
                                        <% } else { %>
                                            <span class="muted-text">Unavailable</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</body>
</html>
