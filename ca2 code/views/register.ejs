<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - SkyWings</title>
    <link rel="stylesheet" href="/css/style.css">


</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <%- include('partials/flash') %>
        <div class="card p-4" style="width:400px;">
            <h2>Create an Account</h2>
            <form action="/register" method="POST">
                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" class="form-control text-center" id="username" name="username" required>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" class="form-control text-center" id="email" name="email" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" class="form-control text-center" id="password" name="password" required minlength="6">
                    <small id="passwordHint" class="input-hint">Min 6 characters</small>
                </div>
                <div class="field">
                    <label for="address">Address</label>
                    <input type="text" class="form-control text-center" id="address" name="address" required>
                </div>
                <div class="field">
                    <label for="contact">Contact Number</label>
                    <input type="text" class="form-control text-center" id="contact" name="contact" required>
                </div>
                <button type="submit" class="btn">Register</button>
            </form>
            <p style="margin-top:14px; color:var(--muted);">Already have an account? <a href="/login">Login here</a></p>
        </div>
    </div>
</body>
</html>
